{
  "name": "teambot",
  "version": "0.0.1",
  "private": true,
  "description": "Operate Codex CLI from mobile Microsoft Teams and receive progress.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test --experimental-strip-types \"tests/**/*.test.ts\" \"src/**/*.test.ts\"",
    "gen:codex-schema": "node scripts/gen-codex-schema.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.3"
  }
}
